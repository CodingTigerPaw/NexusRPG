{
  "name": "nexus-rpg",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:dev": "npm run check && npm run build && serverless deploy --stage dev",
    "deploy:stable": "npm run check && npm run build && serverless deploy --stage stable",
    "deploy:prod": "npm run deploy:stable"
  },
  "dependencies": {
    "@3d-dice/dice-box-threejs": "^0.0.12",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "axios": "^1.15.2",
    "bits-ui": "^1.3.19",
    "clsx": "^2.1.1",
    "lucide-svelte": "^0.468.0",
    "tailwind-merge": "^2.5.5",
    "tailwind-variants": "^0.3.0",
    "three": "^0.184.0",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/package": "^2.3.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^25.6.0",
    "@types/three": "^0.184.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^24.1.3",
    "msw": "^2.14.6",
    "postcss": "^8.4.49",
    "serverless": "^4.36.0",
    "serverless-cloudfront-invalidate": "^1.12.2",
    "serverless-s3-sync": "^3.5.1",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  }
}
